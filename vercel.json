{
  "buildCommand": "echo 'Building static site...'",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/free-training",
      "has": [{ "type": "host", "value": "ecomuprise.co" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/free-training",
      "has": [{ "type": "host", "value": "www.ecomuprise.co" }],
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/organic-index.html"
    },
    {
      "source": "/application-ads",
      "destination": "/index.html"
    },
    {
      "source": "/application",
      "destination": "/organic-index.html"
    },
    {
      "source": "/application-ads/book",
      "destination": "/booking-page.html"
    },
    {
      "source": "/application/book",
      "destination": "/organic-booking-page.html"
    },
    {
      "source": "/application-ads/confirmation",
      "destination": "/confirmation-page.html"
    },
    {
      "source": "/application/confirmation",
      "destination": "/organic-confirmation.html"
    },
    {
      "source": "/application-ads/education",
      "destination": "/education-page.html"
    },
    {
      "source": "/application/education",
      "destination": "/organic-education.html"
    },
    {
      "source": "/confirmation-page",
      "destination": "/confirmation-page.html"
    },
    {
      "source": "/education-page",
      "destination": "/education-page.html"
    },
    {
      "source": "/1on1",
      "destination": "/1on1.html"
    }
  ]
}
